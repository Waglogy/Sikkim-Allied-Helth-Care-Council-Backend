# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes

# --- CORS (comma-separated allowed browser origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudflare R2 object storage ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Public URL files are served from (r2.dev subdomain or a custom domain).
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
